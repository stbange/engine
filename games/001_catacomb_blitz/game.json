{
  "id": "001_catacomb_blitz",
  "title": "Catacomb Blitz",
  "description": "3-stage retro boomer FPS through solvable BSP/cave/WFC catacombs with 8-way monster sprites, NavGrid A* pursuit, dynamic shadows, and raycast shotgun.",
  "genre": "fps",
  "flagship": true,
  "primitives": ["mesh", "sprite", "particles", "sdf_text"],
  "engine_version": "0.1.0",
  "entry_script": "scripts/main.lua",
  "pipeline": "forward",
  "touch_preset": "dual_stick",
  "xr_mode": "first_person",
  "retro": {
    "vertex_snap": 240,
    "nearest_textures": true,
    "dither_bayer": true,
    "color_bits": 5,
    "crt_scanlines": false,
    "fog_density": 0.025
  },
  "default_locale": "en"
}
