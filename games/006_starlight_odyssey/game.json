{
  "id": "006_starlight_odyssey",
  "title": "Starlight Odyssey",
  "description": "3-world retro 3D collectathon platformer with spherical mini-planetoid radial gravity, a bigger-on-the-inside toyhouse bonus room, and star bosses.",
  "genre": "platformer",
  "flagship": true,
  "primitives": ["mesh", "sprite", "particles", "sdf_text"],
  "engine_version": "0.1.0",
  "entry_script": "scripts/main.lua",
  "pipeline": "forward",
  "touch_preset": "dpad_buttons",
  "xr_mode": "diorama",
  "retro": {
    "vertex_snap": 320,
    "nearest_textures": true,
    "dither_bayer": true,
    "color_bits": 6,
    "crt_scanlines": false,
    "fog_density": 0.006
  },
  "default_locale": "en"
}
